{
  "cleanupPeriodDays": 30,
  "env": {
    "EDITOR": "nvim",
    "VISUAL": "nvim",
    "PAGER": "less",
    "LANG": "ja_JP.UTF-8"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "List(*)",
      "Fetch(https://*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(mv:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(tar:*)",
      "Bash(gzip:*)",
      "Bash(gunzip:*)",
      "Bash(zip:*)",
      "Bash(unzip:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ps:*)",
      "Bash(top:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(whoami:*)",
      "Bash(pwd:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(history:*)",
      "Bash(alias:*)",
      "Bash(env:*)",
      "Bash(export:*)",
      "Bash(source:*)",
      "Bash(ln:*)",
      "Bash(touch:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(diff:*)",
      "Bash(cmp:*)",
      "Bash(rsync:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(ping:*)",
      "Bash(netstat:*)",
      "Bash(lsof:*)",
      "Bash(brew:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(pip:*)",
      "Bash(poetry:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(terraform:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws s3 cp:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(gcloud config list:*)",
      "Bash(gcloud auth list:*)",
      "Bash(az account show:*)",
      "Bash(az account list:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go fmt:*)",
      "Bash(gofmt:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git push origin:*)",
      "Bash(git push --set-upstream:*)",
      "Bash(git pull:*)",
      "Bash(git remote set-url:*)",
      "Bash(git reset --soft:*)",
      "Bash(git reset --mixed:*)",
      "Bash(git cherry-pick:*)",
      "Bash(nix:*)",
      "Bash(nix-env:*)",
      "Bash(home-manager:*)",
      "Bash(darwin-rebuild:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(fd:*)",
      "Bash(bat:*)",
      "mcp__github__create_pull_request",
      "mcp__github__get_issue",
      "mcp__github__add_issue_comment",
      "mcp__github__get_issue_comments",
      "mcp__devinwiki__read_wiki_contents",
      "mcp__devinwiki__ask_question",

      "Bash(jj st)",
      "Bash(jj st:*)",
      "Bash(jj status)",
      "Bash(jj status:*)",
      "Bash(jj log)",
      "Bash(jj log:*)",
      "Bash(jj l)",
      "Bash(jj l:*)",
      "Bash(jj ll)",
      "Bash(jj ll:*)",
      "Bash(jj diff)",
      "Bash(jj diff:*)",
      "Bash(jj show)",
      "Bash(jj show:*)",
      "Bash(jj evolog:*)",
      "Bash(jj op log)",
      "Bash(jj op log:*)",
      "Bash(jj op show:*)",
      "Bash(jj op diff:*)",
      "Bash(jj describe:*)",
      "Bash(jj new)",
      "Bash(jj new:*)",
      "Bash(jj edit:*)",
      "Bash(jj prev)",
      "Bash(jj next)",
      "Bash(jj squash)",
      "Bash(jj squash --from:*)",
      "Bash(jj squash --into:*)",
      "Bash(jj split:*)",
      "Bash(jj abandon:*)",
      "Bash(jj rebase:*)",
      "Bash(jj duplicate:*)",
      "Bash(jj bookmark list)",
      "Bash(jj bookmark list:*)",
      "Bash(jj bookmark create:*)",
      "Bash(jj bookmark move:*)",
      "Bash(jj bookmark delete:*)",
      "Bash(jj bookmark track:*)",
      "Bash(jj bookmark untrack:*)",
      "Bash(jj git fetch)",
      "Bash(jj git fetch:*)",
      "Bash(jj git push --dry-run:*)",
      "Bash(jj resolve --list)",
      "Bash(jj undo)",
      "Bash(jj redo)",
      "Bash(jj op restore:*)",
      "Bash(jj op revert:*)",
      "Bash(jj config get:*)",
      "Bash(jj config list:*)",
      "Bash(jj config path:*)",
      "Bash(jj metaedit:*)",
      "Bash(jj fix:*)",
      "Bash(jj tug)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*credentials*)",
      "Read(**/.aws/credentials)",
      "Read(**/.ssh/id_*)",
      "Read(~/.config/fish/secret-env.fish)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard origin/*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -ffd:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore . :*)",
      "Bash(brew uninstall:*)",

      "Bash(jj resolve)",
      "Bash(jj diffedit:*)",
      "Bash(jj squash -i)",
      "Bash(jj squash --interactive)",
      "Bash(jj split -i)",
      "Bash(jj split --interactive)",
      "Bash(jj si)"
    ],
    "defaultMode": "auto",
    "preferredNotifChannel": "terminal_bell"
  },
  "model": "claude-opus-4-7[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/jj-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/jj-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/jj-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "everything-claude-code@everything-claude-code": false,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "zundamon@cc-zundamon-plugins": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "everything-claude-code": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "default",
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": false,
  "theme": "dark-daltonized",
  "showTurnDuration": false,
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true
}
